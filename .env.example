# Copy this file to .env and fill in your real values.
# .env is gitignored and should NEVER be committed.

# --- Local Temporal server (default) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=   # leave unset for local

# --- Temporal Cloud (uncomment to use) ---
# TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=<namespace>.<account>
# TEMPORAL_API_KEY=<your-temporal-cloud-api-key>

TASK_QUEUE=workspace-lc-queue

# --- Jira Integration ---
JIRA_BASE_URL=https://meghaldiscover.atlassian.net
JIRA_USER_EMAIL=<your-jira-email>
JIRA_API_TOKEN=<your-api-token>
JIRA_PROJECT_KEY=<your-project-key>   # e.g. WL — the prefix before issue numbers
JIRA_DONE_TRANSITION_ID=<transition-id>  # find via API (see README)
